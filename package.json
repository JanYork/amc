{
  "name": "@i-xor/amc",
  "version": "0.1.0",
  "description": "Manage shared Agent Skills from one local store.",
  "type": "module",
  "bin": {
    "amc": "dist/src/main.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "lint": "oxlint src test",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json",
    "test": "npm run build:test && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "coverage": "npm run build:test && node --test --experimental-test-coverage --test-coverage-include=dist/src/**/*.js --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=90 dist/test/*.test.js",
    "prepack": "npm run lint && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0",
  "author": "JanYork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanYork/amc.git"
  },
  "homepage": "https://github.com/JanYork/amc#readme",
  "bugs": {
    "url": "https://github.com/JanYork/amc/issues"
  },
  "keywords": [
    "agent-skills",
    "cli",
    "claude-code",
    "codex",
    "pi",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
